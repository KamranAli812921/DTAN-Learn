# ---------------------------------------------------------------------------
# DTAN Learn — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dtan-learn?retryWrites=true&w=majority

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (file uploads: assignments, materials, avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email — password reset codes)
RESEND_API_KEY=
EMAIL_FROM="DTAN Learn <noreply@yourdomain.com>"

# Zoom Server-to-Server OAuth (institutional account)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret token configured on the Zoom Webhook subscription, used to verify x-zm-signature
ZOOM_WEBHOOK_SECRET_TOKEN=

# Seed script — initial admin account
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@dtanlearn.com
SEED_ADMIN_PASSWORD=ChangeMe123!
